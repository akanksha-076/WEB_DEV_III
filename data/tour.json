----------display all employee------------------------------------
db.employee.find()

------------FIND department wise average salary--------------------
db.employee.aggregate([
  {
    $group: {
      _id: "$dept",
      averageSalary: { $avg: "$salary" }
    }
  }])

-----------find the second highest salary-------------------------
db.employee.aggregate([
  {
    $sort: { salary: -1 }},
    {$group:{_id:"$salary"}},
    {$skip:1},
    {$limit:1}
])

-----------find the second highest salary--------------------------
  
db.employee.aggregate([
  {
    $sort: { salary: -1 }
  },
  {
    $group: {
      _id: null,
      salaries: { $push: "$salary" }
    }
  },
  {
    $project: {
      secondHighestSalary: { $arrayElemAt: ["$salaries", 1] }
    }
  }
])



