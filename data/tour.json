db.students.aggregate([
  {
    $match: { age: { $gt: 20 } }
  },
  {
    $count:"total_students"
  }

])


db.students.aggregate([
  {
    $unwind: "$skills"
  },{
    $group: {
       _id: "$skills",
        count: { $sum: 1 } }
    }])